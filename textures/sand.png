<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16">
  <defs>
    <pattern id="sandPattern" patternUnits="userSpaceOnUse" width="4" height="4">
      <rect x="0" y="0" width="4" height="4" fill="#f1c40f"/>
      <rect x="1" y="1" width="1" height="1" fill="#e67e22"/>
      <rect x="2" y="2" width="1" height="1" fill="#e67e22"/>
      <rect x="3" y="3" width="1" height="1" fill="#e67e22"/>
    </pattern>
  </defs>
  <rect x="0" y="0" width="16" height="16" fill="url(#sandPattern)"/>
</svg>